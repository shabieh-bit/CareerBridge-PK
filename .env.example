DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
NODE_ENV=development
PORT=3000
# Set DATABASE_SSL=true only if your provider requires SSL.
DATABASE_SSL=false

# Optional: Obtain an API key specifically for Pakistan at https://pk.jooble.org/api/about
# Keep it in Render Environment; NEVER commit the actual value.
JOOBLE_PK_API_KEY=
